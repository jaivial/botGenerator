# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Minimax M2.1 (Recommended - better for long prompts and system messages)
MINIMAX_API_KEY=your_minimax_api_key_here

# Google AI (Gemini) - Legacy, kept for backwards compatibility
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# =============================================================================
# WhatsApp (UAzapi) Configuration
# =============================================================================
WHATSAPP_API_URL=https://your-instance.uazapi.com
WHATSAPP_TOKEN=your_uazapi_token_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL Connection String (for bookings and conversation history)
MYSQL_CONNECTION_STRING=Server=localhost;Database=your_database;User=your_user;Password=your_password;

# Alternative: Build connection string from components
DB_HOST_LOCAL=localhost
DB_USER_LOCAL=your_user
DB_PASSWORD_LOCAL=your_password
DB_NAME_LOCAL=your_database

DB_HOST_HOSTINGER=your_hostinger_host
DB_USER_HOSTINGER=your_hostinger_user
DB_PASSWORD_HOSTINGER=your_hostinger_password
DB_NAME_HOSTINGER=your_hostinger_database

# =============================================================================
# EXTERNAL BOOKING API CONFIGURATION
# =============================================================================
# API for fetching existing bookings when users first contact the bot
EXTERNAL_BOOKING_API_URL=https://your-booking-system.com/api
EXTERNAL_BOOKING_API_KEY=your_external_api_key_here

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
REDIS_CONNECTION_STRING=localhost:6379

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# To run conversation tests, use these settings instead:
#
# WHATSAPP_API_URL=http://localhost:8080
# WHATSAPP_TOKEN=test-token
#
# Then run:
#   1. cd testing && ./start_mock_server.sh
#   2. ./start_bot_test_mode.sh (or use the env vars above)
#   3. ./run_conversation_tests.sh
#
# See testing/README.md for more details.
