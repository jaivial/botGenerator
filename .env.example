# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# Anthropic API key for official C# SDK
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MiniMax - kept for Anthropic-compatible backward compatibility
MINIMAX_API_KEY=your_minimax_api_key_here

# Google AI (Gemini) - Legacy, kept for backwards compatibility
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# =============================================================================
# WhatsApp Provider Configuration
# =============================================================================
# Supported values: evolution (default), uazapi (legacy rollback only)
WHATSAPP_PROVIDER=evolution

# UAZAPI configuration, required when WHATSAPP_PROVIDER=uazapi
WHATSAPP_API_URL=https://your-instance.uazapi.com
WHATSAPP_TOKEN=your_uazapi_token_here

# Evolution API v2.4.0-rc2 configuration, required when WHATSAPP_PROVIDER=evolution
# Keep API key and webhook secret out of source control.
EVOLUTION_API_URL=https://your-evolution-api.example
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=your_evolution_instance_name
EVOLUTION_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
MYSQL_CONNECTION_STRING=Server=localhost;Database=your_database;User=your_user;Password=your_password;

DB_HOST_LOCAL=localhost
DB_USER_LOCAL=your_user
DB_PASSWORD_LOCAL=your_password
DB_NAME_LOCAL=your_database

DB_HOST_HOSTINGER=your_hostinger_host
DB_USER_HOSTINGER=your_hostinger_user
DB_PASSWORD_HOSTINGER=your_hostinger_password
DB_NAME_HOSTINGER=your_hostinger_database

# =============================================================================
# EXTERNAL BOOKING API CONFIGURATION
# =============================================================================
EXTERNAL_BOOKING_API_URL=https://your-booking-system.com/api
EXTERNAL_BOOKING_API_KEY=your_external_api_key_here

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_CONNECTION_STRING=localhost:6379

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
